  {
    "name": "CAS plain form login succeeds",
    "operation": "auth.start",
    "args": {
      "username": "fixture-student",
      "password": "synthetic-password"
    },
    "http": [
      {
        "url": "https://auth.hainnu.edu.cn:9443/cas/login?service=https%3A%2F%2Fzfjw.hainnu.edu.cn%2Fjwglxt%2Fxtgl%2Flogin_sso.html",
        "purpose": "auth",
        "response": {
          "status": 200,
          "url": "https://auth.hainnu.edu.cn:9443/cas/login?service=https%3A%2F%2Fzfjw.hainnu.edu.cn%2Fjwglxt%2Fxtgl%2Flogin_sso.html",
          "headers": {},
          "body": "<html><body><div class=\"login-page\"><form method=\"post\"><input type=\"hidden\" name=\"execution\" value=\"e1s1\" /><input type=\"hidden\" name=\"_eventId\" value=\"submit\" /><input type=\"hidden\" name=\"geolocation\" /><input id=\"username\" name=\"username\" value=\"\" /><input id=\"password\" name=\"password\" value=\"\" /></form></div></body></html>"
        }
      },
      {
        "url": "https://auth.hainnu.edu.cn:9443/cas/login?service=https%3A%2F%2Fzfjw.hainnu.edu.cn%2Fjwglxt%2Fxtgl%2Flogin_sso.html",
        "purpose": "auth",
        "method": "POST",
        "form": {
          "username": "fixture-student",
          "password": "synthetic-password",
          "execution": "e1s1",
          "_eventId": "submit",
          "geolocation": ""
        },
        "response": {
          "status": 200,
          "url": "https://zfjw.hainnu.edu.cn/jwglxt/xtgl/index_initMenu.html",
          "headers": {},
          "body": "<html>Home</html>"
        }
      },
      {
        "url": "https://zfjw.hainnu.edu.cn/jwglxt/xtgl/index_cxYhxxIndex.html?gnmkdm=index",
        "purpose": "query",
        "response": {
          "status": 200,
          "url": "https://zfjw.hainnu.edu.cn/jwglxt/xtgl/index_cxYhxxIndex.html?gnmkdm=index",
          "headers": {},
          "body": "<h4 class=\"media-heading\">模拟同学 学生</h4><input id=\"sessionUserKey\" value=\"fixture-student\">"
        }
      }
    ],
    "expect": {
